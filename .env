# Variables d'environnement par défaut. Les vraies valeurs viennent de
# .env.local en dev (non versionné) et du rôle Ansible service-gazette en prod.
# Jamais de secret dans ce fichier : le dépôt et l'image sont publics.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> homelab-gazette ###
# Nom par défaut d'un nouveau numéro (modifiable numéro par numéro).
GAZETTE_NAME="La gazette"

# Les membres de la famille, tels que le prompt les présente (prénoms et rôles,
# texte libre) : « Alice (la maman), Bob (le papa), Léo et Emma (les enfants) ».
GAZETTE_FAMILY=

# Immich : adresse et clé d'API dédiée (Paramètres du compte → Clés d'API),
# permissions album.read, asset.read, asset.view, person.read.
IMMICH_URL=
IMMICH_API_KEY=

# Autorité de certification à approuver pour les appels HTTPS (CA mkcert en dev).
TLS_CA_FILE=

# Dossier des numéros (un fichier JSON par numéro). Vide = var/data.
# En prod : un volume privé, sauvegardé.
GAZETTE_DATA_DIR=

# Gabarit du prompt « Copier le prompt ». Vide = config/prompt.txt de l'image.
GAZETTE_PROMPT_FILE=
###< homelab-gazette ###
